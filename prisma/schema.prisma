// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Todo {
  id          String   @id @default(uuid())
  title       String
  description String?
  isCompleted Boolean  @default(false)
  priority    Priority @default(MEDIUM)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("todos")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ProjectHealthReport {
  id                     String   @id @default(uuid())
  projectName            String   @map("project_name")
  score                  Int
  status                 String
  testsPassing           Int      @map("tests_passing")
  totalTests             Int      @map("total_tests")
  mdcRulesActive         Int      @map("mdc_rules_active")
  architectureViolations Int      @map("architecture_violations")
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("project_health_reports")
}

model SpecDocument {
  id                      String   @id @default(uuid())
  title                   String
  filePath                String   @map("file_path")
  status                  String
  acceptanceCriteriaCount Int      @map("acceptance_criteria_count")
  isValidated             Boolean  @default(false) @map("is_validated")
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([status])
  @@map("spec_documents")
}

model SecurityAuditLog {
  id           String   @id @default(uuid())
  targetSystem String   @map("target_system")
  severity     String
  findings     Int
  status       String
  auditedBy    String   @map("audited_by")
  tenantId     String?  @map("tenant_id")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([createdAt])
  @@index([status])
  @@index([tenantId])
  @@map("security_audit_logs")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("FREE") // FREE | PRO | ENTERPRISE
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  securityAudits SecurityAuditLog[]
  communityRules CommunityRule[]

  @@map("tenants")
}

model CommunityRule {
  id          String   @id @default(uuid())
  ruleId      String   @unique @map("rule_id")
  title       String
  description String
  category    String   // LGPD | HIPAA | FINTECH | GENERAL
  content     Json     // Definição da regra em JSON/AST
  authorId    String   @map("author_id")
  tenantId    String?  @map("tenant_id")
  isPublic    Boolean  @default(true) @map("is_public")
  downloads   Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([category])
  @@index([isPublic])
  @@map("community_rules")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventName   String    @map("event_name")
  payload     Json
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([processedAt])
  @@index([createdAt])
  @@map("outbox_events")
}
