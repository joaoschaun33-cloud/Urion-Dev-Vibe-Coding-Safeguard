// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Todo {
  id          String   @id @default(uuid())
  title       String
  description String?
  isCompleted Boolean  @default(false)
  priority    Priority @default(MEDIUM)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("todos")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ProjectHealthReport {
  id                     String   @id @default(uuid())
  projectName            String   @map("project_name")
  score                  Int
  status                 String
  testsPassing           Int      @map("tests_passing")
  totalTests             Int      @map("total_tests")
  mdcRulesActive         Int      @map("mdc_rules_active")
  architectureViolations Int      @map("architecture_violations")
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("project_health_reports")
}

model SpecDocument {
  id                      String   @id @default(uuid())
  title                   String
  filePath                String   @map("file_path")
  status                  String
  acceptanceCriteriaCount Int      @map("acceptance_criteria_count")
  isValidated             Boolean  @default(false) @map("is_validated")
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([status])
  @@map("spec_documents")
}

model SecurityAuditLog {
  id           String   @id @default(uuid())
  targetSystem String   @map("target_system")
  severity     String
  findings     Int
  status       String
  auditedBy    String   @map("audited_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([status])
  @@map("security_audit_logs")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventName   String    @map("event_name")
  payload     Json
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([processedAt])
  @@index([createdAt])
  @@map("outbox_events")
}
