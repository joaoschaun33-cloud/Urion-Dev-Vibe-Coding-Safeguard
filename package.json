{
  "name": "urion-safeguard",
  "version": "2.0.1",
  "description": "Repositorio blindado e escalavel para desenvolvimento com IA (vibe coding).",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "dist/app/server.js",
  "bin": {
    "urion-safeguard": "./bin/urion-safeguard.cjs",
    "urion": "./bin/urion-safeguard.cjs",
    "urion-mcp-server": "./bin/urion-mcp-server.mjs",
    "urion-checks": "./bin/urion-checks.mjs"
  },
  "scripts": {
    "cli": "node bin/urion-safeguard.cjs",
    "scanner": "node bin/urion-safeguard.cjs scanner",
    "blueprint": "node bin/urion-safeguard.cjs blueprint",
    "rules": "node bin/urion-safeguard.cjs rules",
    "dev": "tsx watch src/app/server.ts",
    "create:app": "node bin/create-vibe-safeguard.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm run sync:rules:guard && npm run build:mcp && npm run build:checks && tsc",
    "build:mcp": "esbuild src/mcp/index.ts --bundle --platform=node --format=esm --outfile=bin/urion-mcp-server.mjs --banner:js=\"#!/usr/bin/env node\"",
    "build:checks": "esbuild src/features/security-audit/presentation/checks-cli.ts --bundle --platform=node --format=esm --outfile=bin/urion-checks.mjs --banner:js=\"#!/usr/bin/env node\"",
    "checks": "tsx src/features/security-audit/presentation/checks-cli.ts",
    "sync:rules:guard": "tsx scripts/sync-vibe-guard-rules.ts",
    "start": "node dist/app/server.js",
    "test": "vitest run",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:smoke": "node checks/smoke.test.js",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "cursor-doctor": "node tools/cursor-doctor.js",
    "sync:rules": "node scripts/sync-ide-rules.mjs",
    "doctor:cli": "node tools/dashboard-cli.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "generate:feature": "node scripts/generate-feature.mjs",
    "setup": "bash first-time.sh",
    "postinstall": "prisma generate",
    "prepare": "husky || exit 0",
    "prepublishOnly": "npm run build:mcp && npm run build:checks",
    "test:integration:local": "node scripts/with-embedded-postgres.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@prisma/client": "^5.16.0",
    "awilix": "13.0.5",
    "bullmq": "6.0.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-rate-limit": "8.6.1",
    "helmet": "^7.1.0",
    "ioredis": "6.0.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.0",
    "prisma": "^5.16.0",
    "rate-limit-redis": "6.0.0",
    "yaml": "2.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "5.1.3",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitest/coverage-v8": "^2.0.0",
    "esbuild": "0.28.1",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "lint-staged": {
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "embedded-postgres": "18.4.0-beta.17"
  }
}
