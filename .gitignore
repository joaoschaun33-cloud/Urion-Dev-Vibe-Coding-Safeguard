# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.out/
.next/
pr-comment.md

# Environment
.env
.env.local
.env.*.local

# IDE
# settings.json e extensions.json sao config compartilhada do time (formatter,
# lint on save, extensoes recomendadas) — cursor-doctor.js exige que existam.
# So ignora o resto (ex.: launch.json com paths locais).
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Testing
coverage/
.nyc_output/

# Misc
*.tgz
*.tar.gz
.urion/*
!.urion/audit/

# Vitest temp files
vitest.config.ts.timestamp-*.mjs

# Bundle gerado do MCP server (produzido por build:mcp/prepublishOnly)
bin/urion-mcp-server.mjs

# scripts temporarios de smoke MCP (nao commitar)
tmp-mcp-smoke*.mjs

# Bundle gerado do Config Gate (produzido por build:checks/prepublishOnly)
bin/urion-checks.mjs

# Pacote npm da ferramenta (gerado por scripts/build-npm-package.mjs)
.npm-package/

# Dados brutos da medicao em repositorios reais (terceiros): nunca versionar
benchmarks/real/data/
